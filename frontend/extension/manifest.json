{
  "manifest_version": 3,
  "name": "文章批量导出助手 · 浏览器同步扩展",
  "version": "1.4.0",
  "description": "自动无感同步全网平台登录态，并通过用户本机家庭宽带 IP 直连抓取博文，彻底告别机房 IP 拦截与封控。",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.zhihu.com/*",
    "*://*.weibo.com/*",
    "*://*.weibo.cn/*",
    "https://doc.305758.xyz/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://doc.305758.xyz/*",
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:*/*",
        "http://localhost:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "文章批量导出助手 · 官方同步扩展"
  },
  "icons": {
    "128": "icon.png"
  }
}
