# ==============================================
# BlogDistiller · 开源安全与隐私防护规则 (.gitignore)
# ==============================================

# ----------------------------------------------
# 1. 生产服务器与私有部署凭证（最高安全防护）
# ----------------------------------------------
deploy_to_server.py
deploy_*.py
DEPLOY_*.md
PROJECT_REVIEW.md

# ----------------------------------------------
# 2. 环境变量与私有配置 (保护 API Key & 密码)
# ----------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# ----------------------------------------------
# 3. 真实用户登录会话与抓取数据库（保护个人隐私）
# ----------------------------------------------
data/*.json
!data/*.example.json
data/*.db
data/*.sqlite*
data/albums/
*.cookie
cookies.json
tokens.json

# ----------------------------------------------
# 4. 本地下载输出与临时缓存
# ----------------------------------------------
downloads/
downloads/*
output/
output/*
scratch/
scratch/*
*.log
logs/

# ----------------------------------------------
# 5. Python 虚拟环境与编译缓存
# ----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
build/
dist/
*.egg-info/
.eggs/

# ----------------------------------------------
# 6. Node.js 与桌面端构建产物
# ----------------------------------------------
node_modules/
desktop/node_modules/
desktop/out/
package-lock.json

# ----------------------------------------------
# 7. IDE 与操作系统生成文件
# ----------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
